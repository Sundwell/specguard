#!/usr/bin/env python3
"""Glue screenshots into one side-by-side sheet with a label over each column.

Usage: compare-sheet <out.png> LABEL:path [LABEL:path ...]

Columns keep their pixel size and are aligned at the top, so a row in one column sits at
the same height as the matching row in the next one. Shorter columns are padded at the
bottom. Needs ffmpeg; nothing else.

Scroll the whole page once before a full-page screenshot: reveal-on-scroll sections are captured
at opacity 0 otherwise and the column comes out blank exactly where the change is.
"""
import os
import shutil
import subprocess
import sys

FONTS = (
    "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
    "/usr/share/fonts/dejavu/DejaVuSans-Bold.ttf",
    "/usr/share/fonts/TTF/DejaVuSans-Bold.ttf",
    "/System/Library/Fonts/Supplemental/Arial Bold.ttf",
    "/Library/Fonts/Arial Bold.ttf",
)
BAND = 56
GUTTER = 6
BG = "0x141414"
LINE = "0x3a3f46"


def label_font():
    for path in (os.environ.get("COMPARE_SHEET_FONT"),) + FONTS:
        if path and os.path.isfile(path):
            return path
    sys.exit("no label font found, set COMPARE_SHEET_FONT to a .ttf file")


def probe(path):
    out = subprocess.run(
        ["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries",
         "stream=width,height", "-of", "csv=p=0:s=x", path],
        capture_output=True, text=True, check=True).stdout.strip()
    w, h = out.split("x")[:2]
    return int(w), int(h)


def main(argv):
    if len(argv) < 3:
        sys.exit("usage: compare-sheet <out.png> LABEL:path [LABEL:path ...]")
    if not shutil.which("ffmpeg"):
        sys.exit("ffmpeg is not on PATH")
    font = label_font()
    out = argv[1]
    cols = []
    for item in argv[2:]:
        label, _, path = item.partition(":")
        if not path:
            sys.exit(f"expected LABEL:path, got {item}")
        w, h = probe(path)
        cols.append({"label": label.upper(), "path": path, "w": w, "h": h})

    top = max(c["h"] for c in cols)
    parts, names = [], []
    for i, c in enumerate(cols):
        pad_right = GUTTER if i < len(cols) - 1 else 0
        chain = (
            f"[{i}:v]pad={c['w']}:{top + BAND}:0:{BAND}:color={BG},"
            f"drawtext=fontfile='{font}':text='{c['label']}':fontcolor=white:fontsize=26:"
            f"x=(w-text_w)/2:y=({BAND}-text_h)/2,"
            f"pad={c['w'] + pad_right}:{top + BAND}:0:0:color={LINE}[v{i}]"
        )
        parts.append(chain)
        names.append(f"[v{i}]")
    parts.append("".join(names) + f"hstack=inputs={len(cols)}[out]")

    cmd = ["ffmpeg", "-y", "-loglevel", "error"]
    for c in cols:
        cmd += ["-i", c["path"]]
    cmd += ["-filter_complex", ";".join(parts), "-map", "[out]", "-frames:v", "1", out]
    subprocess.run(cmd, check=True)

    w, h = probe(out)
    print(f"{out}  {w}x{h}  columns: " + ", ".join(f"{c['label']} {c['w']}x{c['h']}" for c in cols))


if __name__ == "__main__":
    main(sys.argv)
